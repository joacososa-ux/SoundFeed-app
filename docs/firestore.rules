rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function text(v, max) { return v is string && v.size() > 0 && v.size() <= max; }
    function mine() {
      return signedIn()
        && request.resource.data.uid == request.auth.uid
        && text(request.resource.data.author, 60)
        && request.resource.data.createdAt == request.time;
    }

    // Insignia Premium: solo vale si el plan figura en users/<uid> (lo escribe el administrador).
    function isPremium() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.plan == 'premium'; }
    function badgeOk() { return !('premium' in request.resource.data) || (request.resource.data.premium == true && isPremium()); }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;

      match /favorites/{id} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn() && request.auth.uid == uid && isPremium()
          && id.matches('^[a-z0-9-]{1,80}$')
          && text(request.resource.data.title, 80)
          && text(request.resource.data.artist, 60)
          && request.resource.data.genre is string && request.resource.data.genre.size() <= 40
          && request.resource.data.moods is list && request.resource.data.moods.size() <= 4
          && request.resource.data.createdAt == request.time
          && request.resource.data.keys().hasOnly(['title', 'artist', 'genre', 'moods', 'createdAt']);
        allow delete: if signedIn() && request.auth.uid == uid;
        allow update: if false;
      }
    }

    match /forums/{slug} {
      allow read: if true;
      allow create: if signedIn()
        && slug.matches('^[a-z0-9-]{1,80}$')
        && text(request.resource.data.title, 80)
        && text(request.resource.data.artist, 60)
        && request.resource.data.genre is string && request.resource.data.genre.size() <= 40
        && request.resource.data.moods is list && request.resource.data.moods.size() <= 4
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly(['title', 'artist', 'genre', 'moods', 'createdAt', 'createdBy']);
      allow update, delete: if false;

      match /threads/{id} {
        allow read: if true;
        allow create: if mine()
          && request.resource.data.category in ['letra', 'debate', 'anecdotas', 'similares']
          && text(request.resource.data.title, 120)
          && text(request.resource.data.body, 1500)
          && badgeOk()
          && request.resource.data.keys().hasOnly(['category', 'title', 'body', 'uid', 'author', 'createdAt', 'premium']);
        allow update, delete: if false;
      }

      match /posts/{id} {
        allow read: if true;
        allow create: if mine()
          && text(request.resource.data.threadId, 40)
          && text(request.resource.data.body, 1500)
          && badgeOk()
          && request.resource.data.keys().hasOnly(['threadId', 'body', 'uid', 'author', 'createdAt', 'premium']);
        allow update, delete: if false;
      }

      // Un "me gusta" por persona y elemento: el id del documento es <elemento>_<uid>.
      match /likes/{id} {
        allow read: if true;
        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && text(request.resource.data.targetId, 40)
          && id == request.resource.data.targetId + '_' + request.auth.uid
          && request.resource.data.keys().hasOnly(['targetId', 'uid']);
        allow delete: if signedIn() && resource.data.uid == request.auth.uid;
        allow update: if false;
      }
    }
  }
}
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function text(v, max) { return v is string && v.size() > 0 && v.size() <= max; }
    function mine() {
      return signedIn()
        && request.resource.data.uid == request.auth.uid
        && text(request.resource.data.author, 60)
        && request.resource.data.createdAt == request.time;
    }

    match /forums/{slug} {
      allow read: if true;
      allow create: if signedIn()
        && slug.matches('^[a-z0-9-]{1,80}$')
        && text(request.resource.data.title, 80)
        && text(request.resource.data.artist, 60)
        && request.resource.data.genre is string && request.resource.data.genre.size() <= 40
        && request.resource.data.moods is list && request.resource.data.moods.size() <= 4
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly(['title', 'artist', 'genre', 'moods', 'createdAt', 'createdBy']);
      allow update, delete: if false;

      match /threads/{id} {
        allow read: if true;
        allow create: if mine()
          && request.resource.data.category in ['letra', 'debate', 'anecdotas', 'similares']
          && text(request.resource.data.title, 120)
          && text(request.resource.data.body, 1500)
          && request.resource.data.keys().hasOnly(['category', 'title', 'body', 'uid', 'author', 'createdAt']);
        allow update, delete: if false;
      }

      match /posts/{id} {
        allow read: if true;
        allow create: if mine()
          && text(request.resource.data.threadId, 40)
          && text(request.resource.data.body, 1500)
          && request.resource.data.keys().hasOnly(['threadId', 'body', 'uid', 'author', 'createdAt']);
        allow update, delete: if false;
      }

      // Un "me gusta" por persona y elemento: el id del documento es <elemento>_<uid>.
      match /likes/{id} {
        allow read: if true;
        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && text(request.resource.data.targetId, 40)
          && id == request.resource.data.targetId + '_' + request.auth.uid
          && request.resource.data.keys().hasOnly(['targetId', 'uid']);
        allow delete: if signedIn() && resource.data.uid == request.auth.uid;
        allow update: if false;
      }
    }
  }
}
